{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The existing JS pages keep working untouched; new work is TS and pages migrate
    // as they are edited rather than in one sweep.
    "allowJs": true,
    "checkJs": false,
    // `vite/client` types `import.meta.env`, which is how a deployment points the app at its
    // own Metis review UI without a rebuild of the module that names it.
    "types": ["vitest/globals", "node", "vite/client"]
  },
  "include": ["src"]
}
